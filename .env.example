# ─────────────────────────────────────────────────────────────────────────────
# ZZignal — environment template
#
# Copy this file to `.env` and fill in your real values:
#   cp .env.example .env
#
# NEVER commit `.env` to git. `.gitignore` already excludes it.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Polymarket credentials ──────────────────────────────────────────────────
# Ethereum private key of the wallet you use with Polymarket.
# Hex-encoded 32 bytes, with or without the 0x prefix.
POLYMARKET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# L2 CLOB API credentials.
# Obtain them from Polymarket: https://polymarket.com/settings?tab=api-keys
CLOB_API_KEY=your-api-key-uuid
CLOB_API_SECRET=your-api-secret
CLOB_API_PASSPHRASE=your-passphrase

# ─── Funder (proxy/deposit) wallet ───────────────────────────────────────────
# Address of the Polymarket proxy/deposit wallet that holds your pUSD balance.
# This is the public on-chain account that funds your orders (SignatureType
# Poly1271). You can find it on polymarket.com under your profile/deposit
# address. The EOA derived from POLYMARKET_PRIVATE_KEY is only used to sign.
POLYMARKET_FUNDER_ADDRESS=0xYOUR_PROXY_WALLET_ADDRESS
