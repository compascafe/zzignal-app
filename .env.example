# ─────────────────────────────────────────────────────────────
#  ZZignal App — Plantilla de credenciales
#  Copia este archivo como `.env` y rellena los valores reales.
#
#  NUNCA subas el archivo `.env` a Git.
#  Asegúrate de que `.gitignore` contiene: .env
# ─────────────────────────────────────────────────────────────

# ─── PostgreSQL ───────────────────────────────────────────────
# Formato: postgres://usuario:contraseña@host:puerto/nombre_db
DATABASE_URL=postgres://zzignal:password@localhost:5432/zzignal_app

# ─── Polymarket Credentials ───────────────────────────────────
# Clave privada Ethereum de la wallet de Polymarket
# Formato: hex de 64 caracteres (con o sin prefijo 0x)
POLYMARKET_PRIVATE_KEY=0xTU_CLAVE_PRIVADA_AQUI

# Credenciales L2 del CLOB
# Obtenlas desde: https://polymarket.com/profile (sección API Keys)
CLOB_API_KEY=tu-api-key-uuid-aqui
CLOB_API_SECRET=tu-api-secret-aqui
CLOB_API_PASSPHRASE=tu-api-passphrase-aqui