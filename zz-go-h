#!/bin/bash
# zz-go-h — Houdini 65 filter controller
# Usage:
#   zz-go-h on              → enable ALL 12 filters
#   zz-go-h off             → disable ALL (RAW mode, sin filtros)
#   zz-go-h list            → show all filters and their current status
#   zz-go-h <name> <name>.. → enable ONLY those filters (disable rest)
#   zz-go-h +<name>         → toggle ON one filter (keep others as-is)
#   zz-go-h -<name>         → toggle OFF one filter
#
# Filter names:
#   frozen_market     F1   block if no ticks for 3s
#   spread_health     F2   block if spread > 5%
#   flash_dump        F3   block if dump_score >= 2
#   min_volume        F4   block if bid/ask vol < 500
#   btc_trend_confirm F5   block if entry against BTC trend
#   reversal_risk     F6   block if reversal risk high (placeholder)
#   spoof_protection  F7   block if spoof detected
#   ask_wall          F8   block if ask_vol > 3x bid_vol
#   mid_price_sanity  F9   block if mid stuck at 0.50 (stale book)
#   imbalance_sanity  F10  block if imbalance corrupt (>10 or <0)
#   session_age       F11  block if secs_left <30s or >840s (boundary)
#   reentry_cooldown  F12  block re-entry within 30s same direction
#
# Recommended H65 set:
#   zz-go-h frozen_market spread_health flash_dump min_volume \
#           btc_trend_confirm spoof_protection ask_wall mid_price_sanity \
#           imbalance_sanity session_age reentry_cooldown

API="${ZZ_API:-http://localhost:8080}"

all_filters=(
    frozen_market
    spread_health
    flash_dump
    min_volume
    btc_trend_confirm
    reversal_risk
    spoof_protection
    ask_wall
    mid_price_sanity
    imbalance_sanity
    session_age
    reentry_cooldown
)

do_list() {
    echo "═══ Houdini 65 Filters ═══"
    echo
    resp=$(curl -s "${API}/api/odiseo/filters" \
        -H 'Content-Type: application/json' \
        -d '{"all":null}' 2>/dev/null)
    
    filters_json=$(echo "$resp" | jq -r '.filters[]? | "\(.[0])|\(.[1])"' 2>/dev/null)
    if [ -n "$filters_json" ]; then
        while IFS='|' read -r name enabled; do
            if [ "$enabled" = "true" ]; then
                printf "  \033[32m[ON]\033[0m  %s\n" "$name"
            else
                printf "  \033[90m[OFF]\033[0m %s\n" "$name"
            fi
        done <<< "$filters_json"
    else
        echo "  (could not fetch filter status — is the backend running?)"
    fi
    echo
    mask=$(echo "$resp" | jq -r '.enabled_mask // 0' 2>/dev/null)
    echo "  bitmask: $mask  (0=RAW, 4095=ALL)"
}

do_all() {
    local on=$1
    if [ "$on" = "true" ]; then
        echo "Enabling ALL 12 filters..."
        curl -s -X POST "${API}/api/odiseo/filters" \
            -H 'Content-Type: application/json' \
            -d '{"all":true}' | jq .
    else
        echo "Disabling ALL filters (RAW mode)..."
        curl -s -X POST "${API}/api/odiseo/filters" \
            -H 'Content-Type: application/json' \
            -d '{"all":false}' | jq .
    fi
}

# Disable all, then enable only specified
do_custom() {
    local filters=("$@")
    
    # First disable all
    curl -s -X POST "${API}/api/odiseo/filters" \
        -H 'Content-Type: application/json' \
        -d '{"all":false}' > /dev/null
    
    # Then enable each specified filter
    local count=0
    local failures=0
    for f in "${filters[@]}"; do
        resp=$(curl -s -X POST "${API}/api/odiseo/filters" \
            -H 'Content-Type: application/json' \
            -d "{\"name\":\"$f\",\"enable\":true}")
        ok=$(echo "$resp" | jq -r '.ok // false' 2>/dev/null)
        if [ "$ok" = "true" ]; then
            printf "  \033[32m[ON]\033[0m  %s\n" "$f"
            ((count++))
        else
            printf "  \033[31m[ERR]\033[0m %s (unknown filter?)\n" "$f"
            ((failures++))
        fi
    done
    echo
    printf "Enabled: %d  Failed: %d\n" "$count" "$failures"
    echo
    do_list
}

do_toggle() {
    local name="$1"
    local enable="$2"
    local label
    [ "$enable" = "true" ] && label="ON" || label="OFF"
    
    resp=$(curl -s -X POST "${API}/api/odiseo/filters" \
        -H 'Content-Type: application/json' \
        -d "{\"name\":\"$name\",\"enable\":$enable}")
    ok=$(echo "$resp" | jq -r '.ok // false' 2>/dev/null)
    if [ "$ok" = "true" ]; then
        echo "Filter '$name' → $label"
    else
        echo "ERROR: could not toggle '$name' (unknown filter?)"
    fi
}

# ─── MAIN ──────────────────────────────────────────────────────────────────────

if [ $# -eq 0 ]; then
    do_list
    exit 0
fi

cmd="$1"
shift

case "$cmd" in
    on|ON|all|ALL)
        do_all "true"
        ;;
    off|OFF|none|NONE|raw|RAW)
        do_all "false"
        ;;
    list|status|ls)
        do_list
        ;;
    +*)
        # Toggle ON
        name="${cmd:1}"
        do_toggle "$name" "true"
        ;;
    -*)
        # Toggle OFF
        name="${cmd:1}"
        do_toggle "$name" "false"
        ;;
    *)
        # Filter names: enable ONLY these, disable rest
        do_custom "$cmd" "$@"
        ;;
esac
